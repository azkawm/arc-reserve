{
  "compilerOptions": {
    "target": "ES2023",
    /*
     * A third runtime context alongside tsconfig.app.json (DOM, browser code) and
     * tsconfig.node.json (pure Node build/config scripts): Playwright's test files run in Node,
     * but page.evaluate() callbacks execute inside the real browser page and reference document
     * / getComputedStyle directly — those need DOM lib types that tsconfig.node.json's Node-only
     * files have no reason to carry.
     */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}
