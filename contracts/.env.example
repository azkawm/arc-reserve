# ArcReserve contracts — deployment environment (hackathon, testnet only, D-027).
# Copy to .env and fill in. contracts/.env is git-ignored; NEVER commit a private key,
# never reuse an Anvil dev key on a public network, never reuse this key anywhere else.

# ---------------------------------------------------------------------------
# Deployer key. DeployLocal reads PRIVATE_KEY and falls back to Anvil #0 when unset,
# so local runs need nothing here. For a testnet broadcast this MUST be a fresh,
# dedicated key funded on that chain only.
#   Create one:            cast wallet new
#   Fund (Base Sepolia):   any Base Sepolia ETH faucet (Coinbase / Alchemy)
#   Fund (Hedera testnet): https://portal.hedera.com testnet HBAR
# ---------------------------------------------------------------------------
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# RPC endpoints per target chain (public defaults; replace with a keyed endpoint
# if you hit rate limits). Pass with --rpc-url or read by the deploy script.
# ---------------------------------------------------------------------------
ANVIL_RPC_URL=http://127.0.0.1:8545
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# Optional: contract verification on Base Sepolia (https://basescan.org/apis).
BASESCAN_API_KEY=

# ---------------------------------------------------------------------------
# Local-demo knobs (Anvil only; both optional).
# ---------------------------------------------------------------------------
# Seed a 10,000 mUSD purchase + market liquidity so the chart has real swaps (DEMO.md §4.1).
DEMO_SEED_LIQUIDITY=false
# Override the demo investor wallet registered in the IdentityRegistry (default: Anvil #1).
DEMO_INVESTOR=
