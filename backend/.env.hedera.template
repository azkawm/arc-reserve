# ArcReserve backend -- REMOTE DEMO HOST, `api` container (indexes Hedera 296, serves both chains).
#
# Copy this to `.env.hedera` on the server (untracked, matches .gitignore's `.env.*`) and adjust
# CORS_ORIGIN for the actual deployed frontend origin if it differs. DATABASE_URL is NOT here --
# docker-compose.deploy.yml sets it to the compose-network postgres service.
#
# Addresses below are from contracts/deployments/296.json, verified live on chain 2026-09-13.
# assetIsToken0 is TRUE on this deployment (per-deployment fact, not configured here -- the
# backend reads it live from the manager on every request, never caches it).

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Primary chain this process INDEXES: Hedera testnet 296.
# Hashio (testnet.hashio.io) is HTTPS only -- no wss:// endpoint exists, hence RPC_WS_URL empty.
# CONFIRMATIONS=1: Hedera consensus is final, there are no reorgs to wait out.
# MAX_BLOCK_RANGE=100: Hashio silently returns an EMPTY result (not an error) for eth_getLogs
#   spans much above this, and CACHES the empty result per (address, fromBlock, toBlock) -- a
#   later retry of the identical query returns empty forever. Measured 2026-09-12/13. Do not
#   raise this without re-measuring the cliff on that specific relay.
# START_BLOCK=40420580: the block that created MockUSD and the registry (first DeployTestnet tx).
# ---------------------------------------------------------------------------
CHAIN_ID=296
RPC_HTTP_URL=https://testnet.hashio.io/api
RPC_WS_URL=
START_BLOCK=40420580
CONFIRMATIONS=1
POLL_INTERVAL_MS=2000
MAX_BLOCK_RANGE=100

REGISTRY_ADDRESS=0xECEbb2dA14751dd4EBD481CA8493ed6d6A6EA78C
FACTORY_ADDRESS=0x7159C03Ce8746E5882aEE2debe2d2cceB68A5d19
MUSD_ADDRESS=0x48D8dad3cF46F99CEc63466cD9AF8F8f56aa301C
COMPANY_VESTING_ADDRESS=

# ---------------------------------------------------------------------------
# Boundary C: this process also SERVES live reads for Arc testnet 5042002 (via ?chainId=5042002)
# without indexing its events -- that is arc-indexer's job, into the same database. Address is
# the AssetFactory on Arc; it is a DIFFERENT contract at the SAME address on Hedera (the deployer
# key hit the same nonce on both chains -- see docs/DECISIONS.md), so never reuse this value for
# the wrong chain.
# ---------------------------------------------------------------------------
RPC_HTTP_URL_5042002=https://arc-testnet.drpc.org

STALE_AFTER_SECONDS=60
ALLOW_MOCK_MARKET_DATA=false

# Comma-separated. Include the deployed frontend origin; add http://localhost:3000 only if you
# also need local-machine browser testing against this remote API.
CORS_ORIGIN=https://arc-reserve.talentor.tech

# Swap-quote wallet (GET /v1/assets/:id/swap-quote). Same address as .env.arc's -- it is
# provisioned independently per chain (self-registered, approved to the manager, funded with
# both tokens), and this process only ever reads its ADDRESS. No private key lives here.
QUOTE_WALLET_ADDRESS=0x20CD53cE543B24094bBB0a5DddBDAeCaC3b78694
