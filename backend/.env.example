# ArcReserve backend — hackathon, testnet only (D-027). Never point this at a mainnet RPC.
# Copy to .env and edit. .env is untracked; this service holds no keys and never signs.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# One shared database for every chain; every row carries chain_id (D-030).
# `npm run db:up` starts the bundled PostgreSQL 16 on port 5450.
DATABASE_URL=postgresql://arcreserve:arcreserve@127.0.0.1:5450/arcreserve

# ---------------------------------------------------------------------------
# Chain. One indexer process per chain; this block configures THIS process.
# Allowed: 31337 (Anvil), 84532 (Base Sepolia), 296 (Hedera testnet). No mainnet.
# ---------------------------------------------------------------------------
CHAIN_ID=31337
RPC_HTTP_URL=http://127.0.0.1:8545
RPC_WS_URL=ws://127.0.0.1:8545
START_BLOCK=0
CONFIRMATIONS=0
POLL_INTERVAL_MS=1000
MAX_BLOCK_RANGE=2000

# Root addresses from contracts/deployments/<chainId>.json. The values below are the
# deterministic addresses a fresh Anvil produces when DeployLocal runs first from account #0.
# Per-asset component addresses are DISCOVERED from AssetSystemDeployed, never configured here.
REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
FACTORY_ADDRESS=0x8A791620dd6260079BF849Dc5567aDC3F2FdC318
MUSD_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# The API can also serve chains this process does NOT index, as long as they are in the
# database and have an endpoint here (Boundary C `?chainId=`). One per chain, optional:
# RPC_HTTP_URL_31337=http://127.0.0.1:8545
# RPC_HTTP_URL_84532=https://sepolia.base.org
# RPC_HTTP_URL_296=
# A chain with rows but no URL answers 503 CHAIN_UNAVAILABLE; it is never read from another
# chain's RPC, which would answer about the wrong chain under the right chain's name.

# ---------------------------------------------------------------------------
# Base Sepolia (84532). Measured against the deployment of 2026-09-11, not guessed:
#
#   START_BLOCK      46703010 — the block that created mockUSD and the registry. The factory
#                    lands one block later; starting there would miss the registry's own
#                    constructor logs.
#   CONFIRMATIONS    8. The public endpoint serves heads that are still moving: at 3 the
#                    indexer logged a one-block rollback within a minute. The reorg path
#                    handled it, but a confirmed head is cheaper than a rebuild.
#   MAX_BLOCK_RANGE  2000. sepolia.base.org refuses eth_getLogs over 10,000 blocks
#                    ("eth_getLogs is limited to a 10,000 range"), so 2000 has headroom.
#   POLL_INTERVAL_MS 6000. At 2000 the shared rate limit rejected API reads ("over rate
#                    limit") while the indexer polled. A keyed RPC would allow faster.
#
# CHAIN_ID=84532
# RPC_HTTP_URL=https://sepolia.base.org
# RPC_WS_URL=
# START_BLOCK=46703010
# CONFIRMATIONS=8
# POLL_INTERVAL_MS=6000
# MAX_BLOCK_RANGE=2000
# REGISTRY_ADDRESS=0x4E80dBDCB2e054501a0e4d34Ca3C1aC535909386
# FACTORY_ADDRESS=0xaFB2329C2331b4E0DBfAd1B9784443ED8bA908BB
# MUSD_ADDRESS=0xc9B53F30584679A7e19216626751529CF520CaB0
# COMPANY_VESTING_ADDRESS=
#
# Take every address from contracts/deployments/84532.json. An EARLIER failed deployment
# left orphan contracts from the same deployer on this chain, including a dead registry at
# 0x481C18A9224D49fa94d4506c89b4980882146677 — configuring that one indexes nothing.
# ---------------------------------------------------------------------------

# Not emitted by any event (created outside the factory in DeployLocal). Optional.
COMPANY_VESTING_ADDRESS=0x09635F643e140090A9A8Dcd712eD6285858ceBef

# Seconds after which a response is marked stale:true in the envelope.
STALE_AFTER_SECONDS=60

# Synthetic OHLC gate. false => /candles returns 503 MOCK_DISABLED on a chain with no
# canonical Uniswap V3 pool. A mock candle is NEVER served as onchain or derived (D-019).
ALLOW_MOCK_MARKET_DATA=false

# Comma-separated allowed origins for the browser app; "*" only in development.
CORS_ORIGIN=http://localhost:3000
