# ArcReserve backend -- REMOTE DEMO HOST, `arc-indexer` container (indexes Circle Arc 5042002).
#
# Copy this to `.env.arc` on the server (untracked). This process has NO public port behind
# nginx -- it only writes to the shared database so the `api` container's Boundary C reads can
# answer for chain 5042002. Its own /v1/health and /v1/assets are reachable at 127.0.0.1:4001 on
# the host for debugging only.
#
# Addresses below are from contracts/deployments/5042002.json, verified live on chain 2026-09-13.
# assetIsToken0 is TRUE on this deployment too (same as Hedera -- read live, never cached).

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Circle Arc testnet 5042002. Gas is paid in USDC (18 decimals at the EVM level); the app-level
# stablecoin is still mUSD at 6 decimals -- MUSD_ADDRESS below, unrelated to gas.
# CONFIRMATIONS=2: keeps the cursor off the exact chain tip on a load-balanced public relay.
# MAX_BLOCK_RANGE=100: dRPC's free plan REJECTS (hard error, not a silent empty result) getLogs
#   spans much above this -- measured cliff between 101 and 201 blocks; its own error text
#   ("ranges over 10000 blocks") understates how low the real limit is. Do not raise without
#   re-measuring on this specific relay, and never trust that error message's number.
#   dRPC's free plan also rejects JSON-RPC BATCHES above 3 requests; the client caps batching to
#   that limit for this chain in code, not via an env var here.
# RPC_WS_URL empty: not required -- the indexer polls.
# START_BLOCK=61742425: the block that created MockUSD and the registry (first DeployTestnet tx).
# ---------------------------------------------------------------------------
CHAIN_ID=5042002
RPC_HTTP_URL=https://arc-testnet.drpc.org
RPC_WS_URL=
START_BLOCK=61742425
CONFIRMATIONS=2
POLL_INTERVAL_MS=2000
MAX_BLOCK_RANGE=100

REGISTRY_ADDRESS=0xdb04496167265b21783D1DF0C9A97C48711fe89C
FACTORY_ADDRESS=0xECEbb2dA14751dd4EBD481CA8493ed6d6A6EA78C
MUSD_ADDRESS=0x7dfe931c0F5cFE65f61a5579193bffe010ebCe46
COMPANY_VESTING_ADDRESS=

STALE_AFTER_SECONDS=60
ALLOW_MOCK_MARKET_DATA=false

# This container's own API surface is not public; CORS is irrelevant, but the field is required.
CORS_ORIGIN=http://localhost:3000

# Swap-quote wallet, same address as .env.hedera's, provisioned independently on this chain.
# Not load-bearing here -- the public `api` container serves Arc's quotes via its own
# RPC_HTTP_URL_5042002 -- but set for consistency in case this port is ever queried directly.
QUOTE_WALLET_ADDRESS=0x20CD53cE543B24094bBB0a5DddBDAeCaC3b78694
